version: "2.2.1"
# date-released: set at each release
# doi: set after the first Zenodo archive (also in backend/fm2/citation.py)
repository-code: "https://github.com/micheleisotti/fermentation-manager-2"
license: AGPL-3.0-or-later
keywords:
  - bioreactor
  - fermentation
  - growth kinetics
  - laboratory automation
  - Applikon ez2-Control
