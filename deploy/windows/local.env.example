# Site-specific settings of Fermentation Manager 2, NOT kept in the repository.
# Copy to C:\ProgramData\FermentationManager\data\local.env and fill in.
# One FM2_NAME=value per line; environment variables set in fm2-service.xml win over this file.

# Controller addresses (IP on the controllers' network)
FM2_R1_ADDRESS=
FM2_R2_ADDRESS=
